<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#17231e">
<title>ورشة الخشب 3D</title>
<style>
*{box-sizing:border-box}
:root{font-family:Arial,Tahoma,sans-serif;color:#edf2ed;background:#111814}
body{margin:0;min-height:100vh;background:#111814}
.topbar{display:flex;justify-content:space-between;align-items:center;padding:18px;background:#1b2820;border-bottom:1px solid #34483a}
h1,h2,p{margin-top:0}h1{margin-bottom:7px;font-size:23px}h1 span{color:#d7a86e}
.topbar p{margin-bottom:0;color:#a9b9ad;font-size:14px}.logo{font-size:35px;color:#d7a86e}
.layout{display:grid;grid-template-columns:1fr;gap:18px;padding:16px;max-width:1100px;margin:auto}
.viewer,.panel{border:1px solid #34443a;border-radius:16px;background:#1a241e;padding:16px;min-width:0}
.viewer-heading{display:flex;justify-content:space-between;align-items:center;gap:8px}
.viewer-heading h2,.panel h2{font-size:18px}.status{font-size:11px;color:#d7c09c}
#canvas-container{position:relative;width:100%;height:340px;overflow:hidden;border-radius:12px;background:#e7e4dc}
#canvas-container canvas{display:block;width:100%;height:100%;touch-action:none}
#loading{position:absolute;inset:45% 0 auto;text-align:center;color:#28352b}
.hint{margin:12px 0 0;color:#aab9ae;font-size:12px;line-height:1.8}
.panel label{display:block;margin:15px 0 7px;color:#dce6dd;font-size:14px}
input,select{width:100%;min-height:45px;border:1px solid #46594b;border-radius:9px;padding:10px;background:#101914;color:#fff;font-size:16px}
button{width:100%;min-height:48px;margin-top:20px;border:0;border-radius:10px;background:#b7834e;color:#fff;font-size:16px;font-weight:bold;cursor:pointer}
button:active{opacity:.8}#message{margin:12px 0 0;color:#b9c9bc;font-size:12px;line-height:1.8}
footer{padding:20px;text-align:center;color:#9aaa9e;font-size:12px}
@media(min-width:760px){.layout{grid-template-columns:minmax(0,1.5fr) minmax(280px,1fr);align-items:start;padding:24px}#canvas-container{height:500px}}
</style>
</head>
<body>
<header class="topbar"><div><h1>ورشة الخشب <span>3D</span></h1><p>صمّم أثاثك بنفسك</p></div><span class="logo">木</span></header>
<main class="layout">
<section class="viewer"><div class="viewer-heading"><h2>معاينة التصميم</h2><span class="status">عرض ثلاثي الأبعاد</span></div>
<div id="canvas-container"><canvas id="cabinet-canvas" aria-label="معاينة الخزانة ثلاثية الأبعاد"></canvas><p id="loading" hidden></p></div>
<p class="hint">اسحب لتدوير الخزانة، وقرّب إصبعين للتكبير. تعمل هذه النسخة دون إنترنت.</p></section>
<section class="panel"><h2>إعدادات الخزانة</h2>
<label for="width">العرض (سم)</label><input id="width" type="number" min="40" max="300" value="120">
<label for="height">الارتفاع (سم)</label><input id="height" type="number" min="60" max="300" value="200">
<label for="depth">العمق (سم)</label><input id="depth" type="number" min="20" max="100" value="55">
<label for="doors">عدد الأبواب</label><select id="doors"><option value="2">بابان</option><option value="3">3 أبواب</option><option value="4">4 أبواب</option><option value="5" selected>5 أبواب</option><option value="6">6 أبواب</option></select>
<label for="color">لون الخشب</label><select id="color"><option value="#a66d3f">بلوط طبيعي</option><option value="#70452b">بني داكن</option><option value="#d2ad7b">خشب فاتح</option><option value="#e8e1d5">أبيض عاجي</option><option value="#343a36">رمادي داكن</option></select>
<button id="update">تحديث التصميم</button><p id="message" role="status">غيّر المقاسات ثم حدّث التصميم.</p>
</section></main><footer>ورشة الخشب 3D — النسخة التجريبية الأولى</footer>
<script>
(() => {
  const canvas=document.getElementById('cabinet-canvas'), ctx=canvas.getContext('2d');
  const container=document.getElementById('canvas-container'), message=document.getElementById('message');
  let rotation=-0.55, zoom=1, options={width:120,height:200,depth:55,doors:5,color:'#a66d3f'};
  let dragging=false,lastX=0,lastY=0,pinchStart=0,pinchZoom=1;
  const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
  function rgb(hex){const n=parseInt(hex.slice(1),16);return [(n>>16)&255,(n>>8)&255,n&255]}
  function shade(hex,f){const c=rgb(hex);return `rgb(${c.map(v=>Math.round(clamp(v*f,0,255))).join(',')})`}
  function resize(){const r=container.getBoundingClientRect(),dpr=Math.min(window.devicePixelRatio||1,2);canvas.width=Math.max(1,Math.round(r.width*dpr));canvas.height=Math.max(1,Math.round(r.height*dpr));draw()}
  function draw(){
    const W=canvas.width,H=canvas.height;if(!W||!H)return;
    const dpr=Math.min(window.devicePixelRatio||1,2);ctx.setTransform(1,0,0,1,0,0);ctx.clearRect(0,0,W,H);
    ctx.fillStyle='#e7e4dc';ctx.fillRect(0,0,W,H);
    const scale=Math.min(W/(options.width*1.45+options.depth*1.25),H/(options.height*1.18))*0.78*zoom;
    const angle=rotation, cs=Math.cos(angle), sn=Math.sin(angle);
    const project=(x,y,z)=>({x:W/2+(x*cs-z*sn)*scale,y:H*0.56-y*scale+(x*sn+z*cs)*scale*0.34});
    const w=options.width,h=options.height,d=options.depth,th=3.5;
    function poly(points,fill,stroke='#55483a'){ctx.beginPath();points.forEach((p,i)=>{const q=project(...p);i?ctx.lineTo(q.x,q.y):ctx.moveTo(q.x,q.y)});ctx.closePath();ctx.fillStyle=fill;ctx.fill();ctx.strokeStyle=stroke;ctx.lineWidth=Math.max(1,scale*.008);ctx.stroke()}
    function box(x1,y1,z1,x2,y2,z2,color){
      poly([[x1,y1,z2],[x2,y1,z2],[x2,y2,z2],[x1,y2,z2]],shade(color,1.04));
      poly([[x2,y1,z1],[x2,y1,z2],[x2,y2,z2],[x2,y2,z1]],shade(color,.72));
      poly([[x1,y2,z1],[x2,y2,z1],[x2,y2,z2],[x1,y2,z2]],shade(color,1.13));
    }
    // Floor shadow
    ctx.save();ctx.globalAlpha=.13;poly([[-w*.62,0,-d*.55],[w*.62,0,-d*.55],[w*.62,0,d*.65],[-w*.62,0,d*.65]],'#665c50','none');ctx.restore();
    // Cabinet body and side panels
    box(-w/2,0,-d/2,-w/2+th,h,d/2,options.color);
    box(w/2-th,0,-d/2,w/2,h,d/2,options.color);
    box(-w/2,h-th,-d/2,w/2,h,d/2,options.color);
    box(-w/2,0,-d/2,w/2,th,d/2,options.color);
    poly([[-w/2+th,th,-d/2],[w/2-th,th,-d/2],[w/2-th,h-th,-d/2],[-w/2+th,h-th,-d/2]],'#c6a783');
    for(let i=1;i<=3;i++){const y=h*i/4;box(-w/2+th,y-1.25,-d/2+2,w/2-th,y+1.25,d/2-3,'#c6a783')}
    // Doors, with narrow gaps and handles
    const inside=w-2*th, dw=inside/options.doors;
    for(let i=0;i<options.doors;i++){
      const x=-w/2+th+dw*i+.5, x2=x+dw-1.2;
      poly([[x,th,d/2+.8],[x2,th,d/2+.8],[x2,h-th,d/2+.8],[x,h-th,d/2+.8]],shade(options.color,1.02),'#6c4b32');
      // subtle inset panel
      const inset=Math.min(4,dw*.08);
      poly([[x+inset,th+inset,d/2+1.1],[x2-inset,th+inset,d/2+1.1],[x2-inset,h-th-inset,d/2+1.1],[x+inset,h-th-inset,d/2+1.1]],'rgba(0,0,0,0)','rgba(255,255,255,.18)');
      const hx=x+dw*.78, hy=h*.51, handleH=Math.max(8,h*.055);
      const p1=project(hx,hy-handleH/2,d/2+3),p2=project(hx,hy+handleH/2,d/2+3);
      ctx.beginPath();ctx.moveTo(p1.x,p1.y);ctx.lineTo(p2.x,p2.y);ctx.strokeStyle='#d8c7a0';ctx.lineWidth=Math.max(2,scale*.012);ctx.lineCap='round';ctx.stroke();
      ctx.beginPath();ctx.arc(p1.x,p1.y,Math.max(1.5,scale*.009),0,Math.PI*2);ctx.fillStyle='#8b7756';ctx.fill();
    }
    // Top edge and dimensions label
    const topA=project(-w/2,h+8,d/2),topB=project(w/2,h+8,d/2);
    ctx.strokeStyle='#746b5d';ctx.lineWidth=Math.max(1,dpr);ctx.setLineDash([4*dpr,4*dpr]);ctx.beginPath();ctx.moveTo(topA.x,topA.y);ctx.lineTo(topB.x,topB.y);ctx.stroke();ctx.setLineDash([]);
    ctx.fillStyle='#28352b';ctx.font=`${Math.max(11,12*dpr)}px Arial`;ctx.textAlign='center';ctx.fillText(`${options.width} × ${options.height} × ${options.depth} سم`,W/2,H-15*dpr);
  }
  function readOptions(){return {width:Number(document.getElementById('width').value),height:Number(document.getElementById('height').value),depth:Number(document.getElementById('depth').value),doors:Number(document.getElementById('doors').value),color:document.getElementById('color').value}}
  function validate(o){if(!Number.isFinite(o.width)||o.width<40||o.width>300)return 'العرض يجب أن يكون بين 40 و300 سم.';if(!Number.isFinite(o.height)||o.height<60||o.height>300)return 'الارتفاع يجب أن يكون بين 60 و300 سم.';if(!Number.isFinite(o.depth)||o.depth<20||o.depth>100)return 'العمق يجب أن يكون بين 20 و100 سم.';return ''}
  document.getElementById('update').addEventListener('click',()=>{const o=readOptions(),err=validate(o);if(err){message.textContent=err;return}options=o;draw();message.textContent=`تم تحديث الخزانة: ${o.width} × ${o.height} × ${o.depth} سم، بعدد ${o.doors} أبواب.`});
  canvas.addEventListener('pointerdown',e=>{dragging=true;lastX=e.clientX;lastY=e.clientY;canvas.setPointerCapture(e.pointerId)});
  canvas.addEventListener('pointermove',e=>{if(!dragging)return;rotation+=(e.clientX-lastX)*.012;zoom=clamp(zoom+(lastY-e.clientY)*.003,.55,2.3);lastX=e.clientX;lastY=e.clientY;draw()});
  const stop=()=>dragging=false;canvas.addEventListener('pointerup',stop);canvas.addEventListener('pointercancel',stop);
  canvas.addEventListener('wheel',e=>{e.preventDefault();zoom=clamp(zoom*(e.deltaY<0?1.08:.92),.55,2.3);draw()},{passive:false});
  canvas.addEventListener('touchstart',e=>{if(e.touches.length===2){pinchStart=Math.hypot(e.touches[0].clientX-e.touches[1].clientX,e.touches[0].clientY-e.touches[1].clientY);pinchZoom=zoom}},{passive:true});
  canvas.addEventListener('touchmove',e=>{if(e.touches.length===2&&pinchStart>0){const dist=Math.hypot(e.touches[0].clientX-e.touches[1].clientX,e.touches[0].clientY-e.touches[1].clientY);zoom=clamp(pinchZoom*dist/pinchStart,.55,2.3);draw()}},{passive:true});
  if('ResizeObserver' in window)new ResizeObserver(resize).observe(container);else window.addEventListener('resize',resize);
  resize();
})();
</script>
</body>
</html>
